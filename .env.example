# Server-side base URL for RSSHub, used by the Vercel function (`api/feeds.ts`)
# and the Vite dev middleware (`vite.config.ts`).
#
# This is a *server* variable: no VITE_ prefix, so it is never bundled into the
# browser. Set it in the Vercel project's Environment Variables (or in
# `.env.local` for local development). It defaults to https://rsshub.app.
#
# Self-hosting RSSHub is recommended if the public instance is rate-limited:
# https://docs.rsshub.app/install
# RSSHUB_BASE=https://rsshub.app
